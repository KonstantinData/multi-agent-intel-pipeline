        <mxCell id="lbl_0" value="Input" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1"><mxGeometry x="60" y="128" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="lbl_1" value="pipeline_runner.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1"><mxGeometry x="360" y="128" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="lbl_2" value="Supervisor Intake Research" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1"><mxGeometry x="840" y="128" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="lbl_3" value="Seeded Runtime State + Handoff" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#0f172a;" parent="1" vertex="1"><mxGeometry x="1290" y="128" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="user_input" value="&lt;b&gt;User / UI Input&lt;/b&gt;
company_name
web_domain
optional on_message hook
(Streamlit oder direkter Caller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;spacing=8;fontColor=#0c4a6e;" parent="1" vertex="1"><mxGeometry x="60" y="180" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="run_start" value="&lt;b&gt;run_pipeline(...) starts&lt;/b&gt;
start_time = perf_counter()
run_id = _timestamp_run_id()  ← UTC sortable
run_dir = resolve_run_dir(run_id, runs_root=RUNS_DIR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="150" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="intake" value="&lt;b&gt;Validate intake + normalize domain&lt;/b&gt;
intake = IntakeRequest(company_name, web_domain)
  → trimmt Felder · setzt language='de'
  → ValueError bei leerem Input → _failed_intake_result()
     failed_phase = 'intake_validation'
normalized_domain = normalize_domain(intake.web_domain)
  ← wird an RunContext.intake + Retrieval weitergereicht" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="280" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Create runtime agents&lt;/b&gt;
agents = create_runtime_agents()
→ Supervisor · Company/Market/Buyer/Contact Dept
→ Synthesis · ReportWriter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="450" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="memory" value="&lt;b&gt;Initialize memory + run context&lt;/b&gt;
memory_store = FileLongTermMemoryStore(LONG_TERM_MEMORY_PATH)
backfill_enabled = _long_term_backfill_enabled()  ← Env-Flag
  → backfill_long_term_memory_from_runs() wenn aktiviert
run_context = RunContext(
  run_id=run_id,
  intake={company_name, web_domain, normalized_domain, language}
)
_record_phase(run_context, 'initialized')
run_context.resolution_state['long_term_memory'] = {
  backfill_enabled, backfilled_patterns
}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="570" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="retrieve" value="&lt;b&gt;Retrieve process patterns&lt;/b&gt;
run_context.retrieved_strategies =
  retrieve_strategies(memory_store,
    domain=normalized_domain, limit=5)
run_context.retrieved_role_strategies = {
  role: retrieve_strategies(..., role=role, limit=3)
  for role in RETRIEVABLE_ROLE_ORDER
}
← Nur Prozessmuster, keine Zielkunden-Fakten" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="800" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="brief_call" value="&lt;b&gt;Build supervisor brief&lt;/b&gt;
supervisor = _build_supervisor_brief(state, on_message)
_record_phase(run_context, 'supervisor_brief')
brief, supervisor_message =
  state.agents['supervisor'].build_intake_brief(state.intake)
← Step 1, noch vor Department-Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="970" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="research_tool" value="&lt;b&gt;src/research/tools.py&lt;/b&gt;
build_company_research(web_domain, company_name)
← aufgerufen innerhalb build_intake_brief()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="980" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="research_steps" value="&lt;b&gt;Research helper sequence&lt;/b&gt;
normalize_domain(web_domain)
homepage_url(normalized_domain)
fetch_website_snapshot(url)
→ Website-Snapshot (title, meta, text)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1100" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity + summary&lt;/b&gt;
infer_company_identity(snapshot)
summarize_visible_text(snapshot)
→ verified_company_name, verified_legal_name
→ name_confidence, homepage_excerpt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1240" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="industry" value="&lt;b&gt;Supervisor enriches brief&lt;/b&gt;
infer_industry(title, description, summary)
→ industry_hint  ← Startsignal für Departments
constructs SupervisorBrief (dataclass)
constructs supervisor_message dict:
  {section: 'supervisor_brief', payload: asdict(brief),
   status: 'ready_for_department_routing'}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1380" width="390" height="150" as="geometry"/></mxCell>
        <mxCell id="runtime_state" value="&lt;b&gt;Seed RunContext with Step-1-Data&lt;/b&gt;
state.run_context.supervisor_brief = supervisor_message['payload']
state.run_context.question_registry = build_question_registry()
  → 11 MEETING_QUESTION_REGISTRY Einträge
state.run_context.answer_matrix = build_initial_answer_matrix()
  → alle Fragen auf status='pending'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;spacing=8;fontColor=#713f12;" parent="1" vertex="1"><mxGeometry x="1290" y="1550" width="610" height="140" as="geometry"/></mxCell>
        <mxCell id="message" value="&lt;b&gt;Emit first runtime event&lt;/b&gt;
state.messages.append(
  emit_message(
    on_message,
    agent='Supervisor',
    content=json.dumps(supervisor_message)
  )
)
→ Event: section='supervisor_brief', status='ready_for_department_routing'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;spacing=8;fontColor=#713f12;" parent="1" vertex="1"><mxGeometry x="1290" y="1710" width="610" height="150" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;Checkpoint: after_supervisor_brief&lt;/b&gt;
_write_checkpoint(
  state.run_dir,
  'after_supervisor_brief',
  state.run_context
)
→ artifacts/runs/{run_id}/checkpoints/after_supervisor_brief.json
← Crash-Recovery-Punkt vor dem ersten Department-Round" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;spacing=8;fontColor=#713f12;" parent="1" vertex="1"><mxGeometry x="1290" y="1880" width="610" height="140" as="geometry"/></mxCell>
        <mxCell id="handoff" value="&lt;b&gt;Step 1 Boundary — Handoff an Step 2&lt;/b&gt;
returns SupervisorBriefResult(brief, supervisor_message)

Nächster Aufruf in run_pipeline():
first_pass = _run_first_pass(state, brief=supervisor.brief)
  → run_supervisor_loop(brief, run_context, agents, on_message)
  → startet Supervisor-controlled Department Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=12;spacing=8;fontColor=#7f1d1d;" parent="1" vertex="1"><mxGeometry x="1290" y="2040" width="610" height="140" as="geometry"/></mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Step 1 live objects (InitialRunState)&lt;/b&gt;
state.run_context  ← Run Brain: Intake + Strategies
  + supervisor_brief + question_registry + answer_matrix
  + resolution_state[initialized, long_term_memory]
state.agents       ← alle Runtime-Agents bereit
state.messages[0]  ← erstes Supervisor-Event
state.budget_tracker  ← PhaseBudgetTracker (leer)
state.run_dir      ← Artefakt-Zielpfad
supervisor.brief   ← SupervisorBrief Dataclass
supervisor.supervisor_message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=12;spacing=8;fontColor=#78350f;" parent="1" vertex="1"><mxGeometry x="1290" y="2200" width="610" height="180" as="geometry"/></mxCell>
