        <mxCell id="user_input" value="&lt;b&gt;User / UI Input&lt;/b&gt;
company_name
web_domain
optional on_message hook
(Streamlit oder direkter Caller)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=12;spacing=8;fontColor=#0c4a6e;" parent="1" vertex="1"><mxGeometry x="60" y="180" width="230" height="130" as="geometry"/></mxCell>
        <mxCell id="run_start" value="&lt;b&gt;run_pipeline(...) starts&lt;/b&gt;
start_time = perf_counter()
run_id = _timestamp_run_id()  ← UTC sortable
run_dir = resolve_run_dir(run_id, runs_root=RUNS_DIR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="150" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="intake" value="&lt;b&gt;Validate intake + normalize domain&lt;/b&gt;
intake = IntakeRequest(company_name, web_domain)
  → trimmt Felder · setzt language='de'
  → ValueError bei leerem Input → _failed_intake_result()
     failed_phase = 'intake_validation'
normalized_domain = normalize_domain(intake.web_domain)
  ← wird an RunContext.intake + Retrieval weitergereicht" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="280" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="agents" value="&lt;b&gt;Create runtime agents&lt;/b&gt;
agents = create_runtime_agents()
→ Supervisor · Company/Market/Buyer/Contact Dept
→ Synthesis · ReportWriter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="450" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="memory" value="&lt;b&gt;Initialize storage boundary + run context&lt;/b&gt;
stores = create_runtime_stores(
  runs_root=RUNS_DIR,
  long_term_memory_path=LONG_TERM_MEMORY_PATH
)
stores.healthcheck_required()
memory_store = stores.long_term_memory
  local_dev → FileLongTermMemoryStore
  production → Postgres/pgvector required, no file fallback
run_context = RunContext(
  run_id=run_id,
  intake={company_name, web_domain, normalized_domain,
          canonical_url, language, resolved_ips, suffix metadata}
)
_record_phase(run_context, 'initialized')
run_context.resolution_state['storage'] = stores.snapshot()
← no opportunistic historical backfill in normal run path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="570" width="420" height="230" as="geometry"/></mxCell>
        <mxCell id="retrieve" value="&lt;b&gt;Initial process-memory retrieval&lt;/b&gt;
context = RetrievalContext(
  run_id, company_name, normalized_domain,
  phase='memory_retrieval', target_scope='run_start'
)
initial_retrieval = retrieve_strategy_batch(
  memory_store, context, DEFAULT_GENERAL_RETRIEVAL_LIMIT
)
run_context.retrieved_strategies = initial_retrieval.patterns
resolution_state['memory_retrieval']['initial'] = snapshot
← generic, no industry hint yet; no domain/company ranking bonus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="820" width="420" height="150" as="geometry"/></mxCell>
        <mxCell id="brief_call" value="&lt;b&gt;Build supervisor brief&lt;/b&gt;
supervisor = _build_supervisor_brief(state, on_message)
_record_phase(run_context, 'supervisor_brief')
brief, supervisor_message =
  state.agents['supervisor'].build_intake_brief(state.intake)
← Step 1, noch vor Department-Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=12;spacing=8;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="360" y="990" width="420" height="130" as="geometry"/></mxCell>
        <mxCell id="research_tool" value="&lt;b&gt;src/research/tools.py&lt;/b&gt;
build_company_research(NormalizedDomainResult, company_name)
→ CompanyResearchResult schema_version
← string domain only as deprecated legacy path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1000" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="research_steps" value="&lt;b&gt;Research helper sequence&lt;/b&gt;
homepage_url = normalized.canonical_url
fetch_website_snapshot(url)
→ WebsiteSnapshot contract
DNS/redirect SSRF guard · IP pinning · max redirects
content-type allowlist · response size limit · content_hash
title/meta/OG/H1/H2/about/imprint/language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1120" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="identity" value="&lt;b&gt;Identity + summary&lt;/b&gt;
infer_company_identity(snapshot)
→ IdentityResolutionResult
  submitted_name · brand_name · verified_company_name
  verified_legal_name='' in MVP + source_gap(register/linkedin/wiki)
summarize_visible_text(snapshot.visible_text)
→ bounded homepage_excerpt + extraction_quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1260" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="industry" value="&lt;b&gt;Supervisor evidence + readiness contract&lt;/b&gt;
infer_industry_result(title, description, summary)
→ IndustryInferenceResult: hint, confidence, evidence_fields, alternatives
CompanyResearchResult warnings/errors:
  fetch_timeout · tls_failed · redirect_blocked · unsupported_content_type
  text_extraction_empty/weak · js_content_detected · industry_unknown
classify_identity_confidence(...) + detect_identity_conflict(...)
BriefingFetchAudit: final_url, redirects, status, content length/lang
EvidenceItem / MissingEvidence per supported field
classify_briefing_readiness(...)
SupervisorBriefMessage:
  schema_version, status, readiness, confidence,
  routing_gaps, evidence_summary, payload
validate_supervisor_brief_message(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;spacing=8;fontColor=#14532d;" parent="1" vertex="1"><mxGeometry x="840" y="1400" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="runtime_state" value="&lt;b&gt;Seed RunContext with Step-1-Data&lt;/b&gt;
state.run_context.supervisor_brief = supervisor_message['payload']
state.run_context.question_registry = build_question_registry()
  → 12 MEETING_QUESTION_REGISTRY Einträge
state.run_context.answer_matrix = build_initial_answer_matrix()
  → alle Fragen auf status='pending'
brief_context = RetrievalContext(
  industry_hint=brief.industry_hint,
  phase='supervisor_brief', question_ids=registry.keys()
)
role_batches = retrieve_strategy_batch(..., role_context(role))
→ retrieved_role_strategies final before Step 2
→ memory_retrieval audit snapshots: initial, brief_context, roles
resolution_state['supervisor_brief'] = non-sensitive diagnosis:
  readiness, confidence, fetch_status, evidence_count,
  routing_gaps, duration_ms
resolution_state['intake_research'] = non-sensitive research diagnostics:
  timings, snapshot audit, warnings/errors, identity + industry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;spacing=8;fontColor=#713f12;" parent="1" vertex="1"><mxGeometry x="1290" y="1630" width="610" height="200" as="geometry"/></mxCell>
        <mxCell id="message" value="&lt;b&gt;Emit first RuntimeEvent&lt;/b&gt;
first_event = emit_message(
  on_message,
  agent='Supervisor',
  content=json.dumps(supervisor_message),
  run_id=state.run_id,
  sequence=len(state.messages)+1,
  phase='supervisor_brief',
  content_type='application/json'
)
→ event_id · sequence · timestamp · schema_version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontSize=12;spacing=8;fontColor=#713f12;" parent="1" vertex="1"><mxGeometry x="1290" y="1850" width="610" height="150" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;Checkpoint: after_supervisor_brief&lt;/b&gt;
_write_checkpoint(
