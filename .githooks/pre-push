#!/usr/bin/env bash
set -euo pipefail

# Optional escape hatch for emergencies:
#   SKIP_PRE_PR_GATES=1 git push
if [[ "${SKIP_PRE_PR_GATES:-0}" == "1" ]]; then
  echo "[pre-push] SKIP_PRE_PR_GATES=1 set; skipping local gate run."
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "[pre-push] Running .codex pre-PR gates..."
python .codex/scripts/run_pre_pr_gates.py --fail-fast
echo "[pre-push] All pre-PR gates passed."
