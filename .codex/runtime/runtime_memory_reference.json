{
  "schema_version": 1,
  "reference": "runtime",
  "memory_backend": {
    "provider": "cloudflare",
    "worker_service": "maip-memory-worker",
    "worker_environment": "dev",
    "d1_binding": "MEMORY_DB",
    "d1_database_name": "maip-memory-dev",
    "api_endpoints": [
      "/healthz",
      "/v1/events"
    ]
  },
  "allowed_event_types": [
    "worker_smoke_test",
    "d1_migration_applied",
    "r2_object_written",
    "vectorize_rebuild_started",
    "vectorize_rebuild_completed",
    "deployment_attempted",
    "deployment_succeeded",
    "deployment_failed",
    "healthcheck_observed",
    "ci_gate_result",
    "schema_change_proposed",
    "schema_change_applied",
    "incident_note",
    "maintenance_note",
    "learning_candidate_created",
    "learning_candidate_rejected",
    "learning_pattern_accepted",
    "query_strategy_candidate",
    "critic_heuristic_candidate",
    "judge_principle_candidate",
    "failure_mode_pattern",
    "test_gap_pattern",
    "report_quality_pattern",
    "department_completion_pattern",
    "scrub_check_passed",
    "scrub_check_failed",
    "policy_rejection",
    "unsafe_payload_rejected",
    "pattern_deprecated",
    "manual_review_required",
    "manual_review_accepted",
    "manual_review_rejected",
    "git_branch_guard_failed",
    "compliance_check_completed",
    "pre_pr_gate_completed",
    "pr_check_failed",
    "pr_fix_attempt_started",
    "pr_fix_attempt_completed",
    "pr_recheck_completed",
    "pr_recovered",
    "learning_pattern_candidate_created"
  ],
  "forbidden_payload_types": [
    "raw_secret",
    "api_token",
    "password",
    "private_key",
    "customer_fact_as_process_memory",
    "run_specific_truth_as_long_term_memory"
  ],
  "constraints": {
    "do_not_store": [
      "raw secrets",
      "api tokens",
      "passwords",
      "private keys",
      "customer-specific facts in long-term process memory",
      "run-specific conclusions as reusable truth"
    ],
    "max_retries_per_phase": 3,
    "escalate_below_confidence": 0.6,
    "escalate_high_risk_below_confidence": 0.75,
    "max_runtime_minutes_without_required_gates": 45,
    "follow_architecture_contracts": true
  }
}
